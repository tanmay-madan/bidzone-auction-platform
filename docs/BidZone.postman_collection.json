{
  "info": {
    "_postman_id": "c1f7a360-8438-4c31-92be-92d4f5bf7962",
    "name": "BidZone Auction Platform API",
    "description": "Postman collection for BidZone Auction Platform (FSD Project).\nIncludes Authentication, Auction CRUD, Concurrency-Safe Bidding, and Idempotency tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "auctionId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token saved:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Bidder\",\n  \"email\": \"alice@bidzone.local\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "2. Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token updated:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@bidzone.local\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Auctions",
      "item": [
        {
          "name": "1. Create Auction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('auctionId', jsonData.id);",
                  "    console.log('Auction ID saved:', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Vintage Mechanical Keyboard\",\n  \"description\": \"IBM Model M in pristine condition\",\n  \"starting_price\": 5000,\n  \"min_increment\": 500,\n  \"starts_at\": \"2026-10-19T00:00:00.000Z\",\n  \"ends_at\": \"2026-10-25T23:59:59.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auctions",
              "host": ["{{baseUrl}}"],
              "path": ["auctions"]
            }
          }
        },
        {
          "name": "2. List Auctions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auctions?status=ACTIVE&sort=ending_soon",
              "host": ["{{baseUrl}}"],
              "path": ["auctions"],
              "query": [
                {
                  "key": "status",
                  "value": "ACTIVE"
                },
                {
                  "key": "sort",
                  "value": "ending_soon"
                }
              ]
            }
          }
        },
        {
          "name": "3. Get Single Auction",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auctions/{{auctionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["auctions", "{{auctionId}}"]
            }
          }
        },
        {
          "name": "4. My Created Auctions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/my-auctions",
              "host": ["{{baseUrl}}"],
              "path": ["my-auctions"]
            }
          }
        }
      ]
    },
    {
      "name": "Bidding & Concurrency",
      "item": [
        {
          "name": "1. Place Valid Bid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "test-uuid-demo-key-1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auctions/{{auctionId}}/bids",
              "host": ["{{baseUrl}}"],
              "path": ["auctions", "{{auctionId}}", "bids"]
            }
          }
        },
        {
          "name": "2. Place Bid - Under minimum increment (Expect 409 BID_TOO_LOW)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5600\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auctions/{{auctionId}}/bids",
              "host": ["{{baseUrl}}"],
              "path": ["auctions", "{{auctionId}}", "bids"]
            }
          }
        },
        {
          "name": "3. Get Auction Bid History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auctions/{{auctionId}}/bids",
              "host": ["{{baseUrl}}"],
              "path": ["auctions", "{{auctionId}}", "bids"]
            }
          }
        },
        {
          "name": "4. My Placed Bids",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/my-bids",
              "host": ["{{baseUrl}}"],
              "path": ["my-bids"]
            }
          }
        }
      ]
    }
  ]
}
