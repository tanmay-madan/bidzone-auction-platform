# ---------------------------------------------------------------
# BidZone API configuration. Copy to .env and fill in.
# ---------------------------------------------------------------
PORT=5000

# "production" turns on strict checks: JWT_SECRET is required,
# benchmark/test bidding modes are disabled, proxy headers trusted.
NODE_ENV=development

# Database: either individual settings (local) ...
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bidzone
# ... or one connection string (Render / Neon / Supabase). Takes priority.
# Use a DIRECT (non-pooled) URL: live updates rely on LISTEN/NOTIFY.
# DATABASE_URL=postgresql://user:password@host:5432/bidzone
# DB_SSL=false        # only if your database does not support SSL
# DB_POOL_MAX=25

# Long random string (at least 32 characters in production).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Comma-separated frontend URLs allowed to call the API (production).
# Empty = allow any origin (local development only).
CORS_ORIGIN=

# Public API address used in uploaded photo links. Detected automatically;
# set it only if photos show the wrong host behind a proxy.
# PUBLIC_API_URL=https://your-api.onrender.com/api

# Automatic auction settlement
SETTLEMENT_SCHEDULER=on
SETTLEMENT_INTERVAL_MS=15000

# Benchmark/evidence switches (?strategy=naive|optimistic, ?anti_sniping=).
# Default: on in development, off in production.
# ALLOW_TEST_MODES=true
